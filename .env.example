# AOM Ops Dashboard -- required env vars
# Copy to .env and fill in values. Never commit .env.

# GitHub Personal Access Token (read-only access to mrg33k/AOM-EA)
# Create at: github.com/settings/tokens → Fine-grained token → mrg33k/AOM-EA → Contents: Read
VITE_GITHUB_TOKEN=ghp_your_token_here

# Dashboard password (you and Ash only)
VITE_DASHBOARD_PASSWORD=your_password_here

# Supabase -- for production chat (Realtime + messages table)
# VITE_ prefix exposes these to the browser (anon key is safe to expose)
# Find at: supabase.com → project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
# Service role key (server-side only, NOT VITE_ prefixed -- never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google OAuth -- for client world Google Calendar + Gmail integrations
# Set up at: console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# APIs to enable: Google Calendar API, Gmail API
# Authorized redirect URIs:
#   Production: https://your-domain.vercel.app/api/google-oauth/callback
#   Development: http://localhost:3000/api/google-oauth/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
