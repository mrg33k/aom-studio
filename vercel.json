    },
    {
      "source": "/:reportClient(wolfpack|ambition|kohrs|ella)/",
      "destination": "/api/report-page?client=:reportClient"
    },
    {
      "source": "/:reportClient(wolfpack|ambition|kohrs|ella)/week-:reportWeek(\\d+)",
      "destination": "/api/report-page?client=:reportClient&week=:reportWeek"
    },
    {
      "source": "/:reportClient(wolfpack|ambition|kohrs|ella)/week-:reportWeek(\\d+)/",
