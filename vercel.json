{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "lab": true,
      "worktree-*": false,
      "agent-*": false,
      "embed-*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/room-steward",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/send-reports",
      "schedule": "0 19 * * 5"
    }
  ],
  "rewrites": [
