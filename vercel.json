{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/outreach-plan", "destination": "/outreach-plan.html" },
    { "source": "/growth-plan", "destination": "/growth-plan.html" },
    { "source": "/system", "destination": "/system.html" },
    { "source": "/v2", "destination": "/v2.html" },
    { "source": "/brand", "destination": "/index.html" },
    { "source": "/brand/:path*", "destination": "/index.html" },
    { "source": "/brands", "destination": "/index.html" },
    { "source": "/brands/:path*", "destination": "/index.html" },
    { "source": "/social", "destination": "/index.html" },
    { "source": "/construction", "destination": "/index.html" },
    { "source": "/research/:path*", "destination": "/index.html" },
    { "source": "/briefs", "destination": "/index.html" },
    { "source": "/briefs/:path*", "destination": "/index.html" },
    { "source": "/audit/:path*", "destination": "/index.html" },
    { "source": "/proposals/isa-energy", "destination": "/proposals-isa.html" },
    { "source": "/proposals/q", "destination": "/proposals-quentin.html" },
    { "source": "/ideas", "destination": "/index.html" },
    { "source": "/guides", "destination": "/index.html" },
    { "source": "/guides/:path*", "destination": "/index.html" },
    { "source": "/roi-calculator", "destination": "/index.html" },
    { "source": "/book", "destination": "/index.html" },
    { "source": "/case-study", "destination": "/index.html" },
    { "source": "/corner", "destination": "/index.html" },
