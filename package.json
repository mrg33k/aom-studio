{
  "name": "aom-v17",
  "private": true,
  "version": "17.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/generate-briefs-index.js && node scripts/build-missions-registry.cjs && node scripts/sync-cv4-static.cjs",
    "prebuild": "node scripts/generate-briefs-index.js && node scripts/build-missions-registry.cjs && node scripts/sync-cv4-static.cjs",
    "build": "vite build && node scripts/emit-dashboard-html.mjs",
    "ios:sync": "node scripts/verify-native-env.mjs && npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test tests/*.spec.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:cv6": "node tests/e2e/run.mjs --surface cv6 --cdp http://127.0.0.1:9222",
    "test:e2e:convex": "node tests/e2e/run.mjs --surface convex-web --baseline tests/e2e/baseline-cv6.json",
    "test:airpods": "node --test tests/airpods-mode.test.mjs",
    "test:tenant-context": "node scripts/check-tenant-context.mjs; a=$?; node scripts/check-no-hardcoded-tenant-slugs.mjs; b=$?; node scripts/check-no-hardcoded-identity.mjs; c=$?; exit $(( a | b | c ))",
    "test:tenant-contract": "node scripts/check-tenant-context.mjs",
    "test:tenant-slugs": "node scripts/check-no-hardcoded-tenant-slugs.mjs",
    "test:identity": "node scripts/check-no-hardcoded-identity.mjs",
    "generate-briefs": "node scripts/generate-briefs-index.js",
    "enrich-municipalities": "node scripts/enrich-municipality-contacts.js",
    "snapshot": "node --env-file=.env scripts/snapshot-dashboard-data.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "convex": "^1.44.0",
    "d3-force": "^3.0.0",
    "firebase": "^10.8.0",
    "framer-motion": "^11.0.0",
    "html-to-image": "^1.11.13",
    "lenis": "^1.3.25",
    "lucide-react": "^0.344.0",
    "mammoth": "^1.12.0",
    "marked": "^17.0.4",
    "pdfjs-dist": "^6.1.200",
    "playwright": "^1.58.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.1",
    "resend": "^6.12.4",
    "three": "^0.183.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "pg": "^8.20.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^7.0.2",
    "vite": "^5.1.6",
    "ws": "^8.20.0"
  },
  "overrides": {
    "scheduler": "^0.23.2"
  }
}
