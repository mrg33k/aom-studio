{
  "nodes": [
    {
      "id": "file:data/blockSchema.js",
      "type": "file",
      "name": "blockSchema.js",
      "filePath": "data/blockSchema.js",
      "summary": "Defines the CV6 chat message block schema: the BLOCK_TYPES catalog (step, success, snag, question, data, summary, code, choice, gallery, etc.) plus small factory helpers to build each block, layered additively on top of a message's plain text.",
      "tags": ["schema-definition", "data-model", "chat", "blocks", "factory"],
      "complexity": "moderate",
      "languageNotes": "Blocks render after plain text (never replacing it), keeping the chat system additive so it never breaks plain-text conversation."
    },
    {
      "id": "file:data/resultLinks.js",
      "type": "file",
      "name": "resultLinks.js",
      "filePath": "data/resultLinks.js",
      "summary": "Decides which links in an agent message deserve a tappable card, pulling from the structured completion payload first and then any http(s) URL in the agent's text so completed web work always lands as a card rather than a bare URL.",
      "tags": ["utility", "links", "chat", "cards", "parsing"],
      "complexity": "moderate"
    },
    {
      "id": "file:data/useCommandTracker.js",
      "type": "file",
      "name": "useCommandTracker.js",
      "filePath": "data/useCommandTracker.js",
      "summary": "Provides the real data hooks behind the Command screen (live agent activity dock + 24h room ledger via useCommand) and the Tracker screen (the real CV6 bug list via useTrackerBugs), with no fabricated data.",
      "tags": ["hook", "live-data", "command", "tracker", "data-source"],
      "complexity": "complex",
      "languageNotes": "The focused goal/checklist binds to an honest summary rather than invented steps because no structured source exists yet."
    },
    {
      "id": "file:data/useDemoBlocks.js",
      "type": "file",
      "name": "useDemoBlocks.js",
      "filePath": "data/useDemoBlocks.js",
      "summary": "Demo block feed for exercising CV6 chat block rendering, assembling a clearly-labelled DEMO stream from the blockSchema factories, activated via ?demo=blocks so it can never be mistaken for real data.",
      "tags": ["hook", "demo", "fixture", "chat", "blocks"],
      "complexity": "moderate"
    },
    {
      "id": "file:data/useHomeData.js",
      "type": "file",
      "name": "useHomeData.js",
      "filePath": "data/useHomeData.js",
      "summary": "Shapes the real Home-screen data (agents, projects, the needs-you Catch Up) from the shared useDataPipe context into the Home fill-in templates, and exposes chat-list, project-mission, and creation helpers used across the surface.",
      "tags": ["hook", "data-source", "home", "wiring", "factory"],
      "complexity": "complex",
      "languageNotes": "Binds the conversation column's goal to honest empties instead of the design's sample text because agent run goal/step data is not exposed yet."
    },
    {
      "id": "file:data/useLiveScribe.js",
      "type": "file",
      "name": "useLiveScribe.js",
      "filePath": "data/useLiveScribe.js",
      "summary": "Live Scribe capture hook that records audio in 15-second chunks, transcribes each via Gemini, extracts action items and decisions every third chunk, and saves the finished session to cm_state, reporting template-friendly state.",
      "tags": ["hook", "audio", "transcription", "livescribe", "live-data"],
      "complexity": "complex",
      "languageNotes": "Chunked base64 conversion replaced an argument-spread that threw RangeError on real chunks; refs plus a pending-work queue fix stale timestamps and the final-chunk save race (2026-07-06 fix)."
    },
    {
      "id": "file:data/useRoomThread.js",
      "type": "file",
      "name": "useRoomThread.js",
      "filePath": "data/useRoomThread.js",
      "summary": "Shapes one room's real conversation from /api/dashboard/supabase-messages into the agent-chat Turn contract (oldest to newest), and exposes goal-thread and room-plan hooks plus work-step-to-block injection for the chat surface.",
      "tags": ["hook", "data-source", "chat", "thread", "wiring"],
      "complexity": "complex"
    },
    {
