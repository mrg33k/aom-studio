      "type": "file",
      "name": "ActivityDock.jsx",
      "filePath": "ActivityDock.jsx",
      "summary": "Floating background-activity dock that mounts in the CornerCV6 shell and follows across every screen, showing live Claude agent sessions from /api/dashboard/active-agents with a sample fallback when idle.",
