      "name": "mediaFallback.js",
      "filePath": "data/mediaFallback.js",
      "summary": "Installs a single global media-error handler that swaps a failed video/audio/img element in place for a 'Couldn't load / Retry' card with a cache-busted retry, shared by Organize and Review previews.",
