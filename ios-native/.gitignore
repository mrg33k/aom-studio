# Per-user Xcode state. Everything else under Corner.xcodeproj IS committed, so a
# fresh clone builds with nothing but Xcode — no xcodegen required to open it.
xcuserdata/
*.xcuserdatad
DerivedData/
build/
.DS_Store

# Render-gallery output (CornerTests/RenderGalleryTests). Images are for looking at,
# not for diffing — there are no golden files here to keep in sync.
RenderGallery/

# corner:corner-smooth-loop — tour credentials and tour output stay out of git
.tour.env
deliverables/screen-tour/

# R15 re-includes the Visual Window fixture photo: the studio root ignores
# *.png, but corner-v2-integration/public/fixtures/hero-portrait.png rides as
# CornerTests/Fixtures/hero.png for the hermetic fixture backend.
!CornerTests/Fixtures/*.png
